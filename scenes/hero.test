# hero scene: light shafts through a window into a foggy room
# generated by gen_hero.py, edit params there not here
size 800 800
integrator pathtracer
spp 4096
importancesampling brdf
nexteventestimation mis
russianroulette on
maxdepth -1
gamma 2.2
output hero.png

